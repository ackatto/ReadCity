@page
@model ReadCity.Pages.ProductModel
@{
	ViewData["Title"] = Model.IsEdit ? "Редактирование" : "Добавление";
}
<h2>@(Model.IsEdit ? "Редактирование" : "Добавление") товара</h2>

<form method="post" enctype="multipart/form-data" style="max-width:900px">
	<input type="hidden" asp-for="Item.Id"/>
	<input type="hidden" asp-for="Item.ImagePath" />
	@if(Model.IsEdit)
	{
		<div class="mb-2"><strong>ID:@Model.Item.Id</strong></div>
	}
	<label>Артикуль товара:</label>
	<input asp-for="Item.Article" class="form-control mb-2" required/>

	<label>Наименование товара:</label>
	<input asp-for="Item.BookName" class="form-control mb-2" required/>

	<label>Категория товара:</label>
	<select asp-for="Item.CategoryId" asp-items="@Model.Categories" class="form-select mb-2" required></select>

	<label>Описание:</label>	
	<textarea asp-for="Item.Description" class="form-control mb-2"></textarea>

	<label>Производитель:</label>
	<select asp-for="Item.ManufacturerId" asp-items="@Model.Manufacturers" class="form-select mb-2" required></select>

	<label>Поставщик:</label>
	<select asp-for="Item.SupplierId" asp-items="@Model.Suppliers" class="form-select mb-2" required></select>

	<label>Цена:</label>
	<input asp-for="Item.Price" type="number" step="0.01" min="0" class="form-control mb-2" required/>

	<label>Единица измерения:</label>
	<input asp-for="Item.Unit" class="form-control mb-2" required/>

	<label>Кол-во на складе:</label>
	<input asp-for="Item.StockQuantity" type="number" min="0" class="form-control mb-2" required/>

	<label>Действующая скидка:</label>
	<input asp-for="Item.Discount" type="number" step="0.01" min="0" max="100" class="form-control mb-2" required/>
	
	<label>Фото товара:</label>
	<input type="file" name ="UploadedImage" class="form-control mb-2"/>
	
	<div>
	<button type="submit" class="btn btn-primary">Сохранить</button>
	<a href="/Products" class="btn btn-secondary">Отмена</a>
	</div>
	
</form>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Если мы добавляем новый товар (Id == 0), можно разрешить открывать (или тоже заблокировать)
        // Давай блокировать любые окна, если уже одно открыто.
        
        let isEditing = localStorage.getItem('isEditing');

        if (isEditing === 'true') {
            alert("Вы уже открыли окно редактирования. Пожалуйста, закройте его, прежде чем открывать новое.");
            window.location.href = '/Products';
        } else {
            localStorage.setItem('isEditing', 'true');
        }

        // Очищаем флаг, если пользователь закрывает вкладку или нажимает "Назад" в браузере
        window.addEventListener('beforeunload', function () {
            localStorage.removeItem('isEditing');
        });

        // Очищаем флаг при отправке формы (Сохранение)
        const form = document.querySelector('form');
        if (form) {
            form.addEventListener('submit', function () {
                localStorage.removeItem('isEditing');
            });
        }
    });
</script>